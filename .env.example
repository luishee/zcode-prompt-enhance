# 增强提示词 · 通道 B（自配端点）配置参考
#
# 通道 A 会自动读 ZCode 自己的 provider 配置（~/.zcode/v2/provider_config.json），
# 通常不需要配这个文件。只有「想换一个端点」或「ZCode 通道不可用」时才用通道 B。
#
# 注意：本文件不会被自动加载（插件由 ZCode 拉起，不经过 shell）。
# 实际生效的两种方式：
#   1) 文件：在 plugins/enhance-service/ 下建 config.json（推荐）
#        {"baseUrl": "https://api.deepseek.com/v1", "apiKey": "sk-xxx", "model": "deepseek-chat"}
#   2) 环境变量：把下面这些变量配进 ZCode 进程所在的环境（高级用法）

# 通道 B 的上游地址与凭据
# PROMPT_ENHANCER_BASE_URL=https://api.deepseek.com/v1
# PROMPT_ENHANCER_API_KEY=sk-xxx
# PROMPT_ENHANCER_MODEL=deepseek-chat

# 通道优先级：zcode（默认）或 fallback
# PROMPT_ENHANCER_PREFER=zcode

# 服务端口（默认 8770；改了之后重新注入时要带 --endpoint）
# PROMPT_ENHANCER_PORT=8770
